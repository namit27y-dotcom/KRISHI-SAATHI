# ============================================================
# KRISHI SAATHI: ENVIRONMENT CONFIGURATION
# ============================================================

# Application Environment & Server Port
NODE_ENV=development
PORT=3000

# ============================================================
# DATABASE CONFIGURATION (MySQL)
# ============================================================
# If MySQL is not running or credentials fail, Krishi Saathi
# automatically uses persistent JSON storage in data/db.json.
#
# To connect to your local MySQL (XAMPP / MySQL Community Server / Workbench):
# 1. Copy this file to .env:
#    cp .env.example .env   (or 'copy .env.example .env' on Windows)
# 2. Enter your MySQL root password below (or your custom MySQL user)
# 3. Create the database if needed: CREATE DATABASE IF NOT EXISTS krishi_saathi;
DB_HOST=localhost
DB_PORT=3306
DB_NAME=krishi_saathi
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Google Gemini AI API Key (from AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps & Weather API Keys
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
WEATHER_API_KEY=your_weather_api_key_here
VITE_WEATHER_API_KEY=your_weather_api_key_here

# Application & Frontend URLs
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=*
